<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Регистрация · BeyGames</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/header') %>
<div class="container main-wrap">
<div class="auth-wrap">
  <div class="auth-box">
    <h2>Регистрация</h2>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <form method="POST" action="/auth/register">
      <div class="form-group"><label>Логин</label><input type="text" name="username" class="form-input" placeholder="3–20 символов" required></div>
      <div class="form-group"><label>Email</label><input type="email" name="email" class="form-input" required></div>
      <div class="form-group"><label>Пароль</label><input type="password" name="password" class="form-input" placeholder="Минимум 6 символов" required></div>
      <div class="form-group"><label>Повторите пароль</label><input type="password" name="password2" class="form-input" required></div>
      <div class="form-group">
        <label>Капча: сколько будет <b style="color:var(--accent)"><%= captchaQ %></b> ?</label>
        <input type="number" name="captcha" class="form-input" placeholder="Введите ответ" required autocomplete="off">
      </div>
      <button type="submit" class="btn-primary btn-full">Зарегистрироваться</button>
    </form>
    <div class="auth-footer">Уже есть аккаунт? <a href="/auth/login">Войти</a></div>
  </div>
</div>
</div>
<%- include('../partials/footer') %>
</body></html>
