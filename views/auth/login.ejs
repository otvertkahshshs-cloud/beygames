<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Вход — Dealerhook.cc</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/header') %>
<div class="container main-wrap">
<div class="auth-wrap">
  <div class="auth-box">
    <h2>Вход на форум</h2>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <form method="POST" action="/auth/login">
      <div class="form-group"><label>Логин</label><input type="text" name="username" class="form-input" required></div>
      <div class="form-group"><label>Пароль</label><input type="password" name="password" class="form-input" required></div>
      <button type="submit" class="btn-primary btn-full">Войти</button>
    </form>
    <div class="auth-footer">Нет аккаунта? <a href="/auth/register">Зарегистрироваться</a></div>
  </div>
</div>
</div>
<%- include('../partials/footer') %>
</body></html>
