<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Подтверждение — BeyGames</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/header') %>
<div class="container main-wrap">
<div class="auth-wrap">
  <div class="auth-box">
    <div style="text-align:center;font-size:40px;margin-bottom:12px">📧</div>
    <h2>Подтвердите email</h2>
    <p style="color:var(--text-dim);font-size:13px;text-align:center;margin-bottom:20px">
      Мы отправили 6-значный код на <b style="color:var(--accent)"><%= email %></b>
    </p>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <form method="POST" action="/auth/verify">
      <div class="form-group">
        <label>Код подтверждения</label>
        <input type="text" name="code" class="form-input" placeholder="123456" maxlength="6" required autocomplete="off" style="font-size:24px;text-align:center;letter-spacing:8px">
      </div>
      <button type="submit" class="btn-primary btn-full">Подтвердить</button>
    </form>
    <div class="auth-footer"><a href="/auth/register">← Назад к регистрации</a></div>
  </div>
</div>
</div>
<%- include('../partials/footer') %>
</body></html>
