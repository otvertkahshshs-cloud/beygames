<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dealerhook.cc</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
.chat-box{margin-top:16px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;overflow:hidden}
.chat-header{padding:10px 14px;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);border-bottom:1px solid var(--border);background:var(--bg3)}
.chat-messages{height:220px;overflow-y:auto;padding:10px 14px;display:flex;flex-direction:column;gap:6px;background:var(--bg2)}
.chat-msg{display:flex;align-items:flex-start;gap:8px;font-size:.83rem}
.chat-msg img{width:22px;height:22px;border-radius:50%;object-fit:cover;flex-shrink:0;margin-top:1px}
.chat-user{color:var(--accent);font-weight:600;white-space:nowrap;margin-right:4px}
.chat-text{color:var(--text);word-break:break-word}
.chat-form{display:flex;border-top:1px solid var(--border);background:var(--bg2)}
.chat-form input{flex:1;background:transparent;border:none;outline:none;padding:9px 14px;color:var(--text);font-size:.85rem}
.chat-form button{background:none;border:none;padding:0 14px;color:var(--accent);cursor:pointer;font-size:1rem}
.chat-form button:hover{color:#fff}
.chat-login-note{padding:10px 14px;font-size:.82rem;color:#888;border-top:1px solid var(--border);background:var(--bg2)}
.chat-login-note a{color:var(--accent)}
</style>
</head>
<body>
<%- include('partials/header') %>
<div class="container main-wrap">

  <div class="gs-hero">
    <h1>dealer<span>hook</span></h1>
    <p>Best Cheat Loader (NL GS)</p>
  </div>

  <div class="index-wrap">
    <div class="forum-main">
      <% for (const cat of categories) { %>
      <div class="category-block">
        <div class="category-header">
          <span class="cat-icon"><%- cat.icon %></span>
          <span class="cat-name"><%= cat.name %></span>
          <span class="cat-desc"><%= cat.description %></span>
        </div>
        <% for (const sec of cat.sections) { %>
        <div class="section-row">
          <div class="sec-icon"><%- sec.icon %></div>
          <div class="sec-info">
            <a href="/forum/section/<%= sec._id %>" class="sec-name"><%= sec.name %></a>
            <div class="sec-desc"><%= sec.description %></div>
          </div>
          <div class="sec-stats">
            <div><span class="stat-num"><%= sec.threadsCount %></span> тем</div>
            <div><span class="stat-num"><%= sec.postsCount %></span> постов</div>
          </div>
          <div class="sec-last">
            <% if (sec.lastThread) { %>
              <a href="/forum/thread/<%= sec.lastThread._id %>" class="last-title"><%= sec.lastThread.title.substring(0,38) %></a>
              <div class="last-meta"><%= sec.lastThread.lastPostUser %></div>
            <% } else { %>
              <span class="no-posts">Нет тем</span>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- LIVE CHAT -->
      <div class="chat-box">
        <div class="chat-header"><i class="fa-solid fa-comments"></i> Живой чат</div>
        <div class="chat-messages" id="chatMessages"></div>
        <% if (user) { %>
        <form class="chat-form" id="chatForm">
          <input type="text" id="chatInput" placeholder="Написать сообщение..." maxlength="300" autocomplete="off">
          <button type="submit"><i class="fa-solid fa-paper-plane"></i></button>
        </form>
        <% } else { %>
        <div class="chat-login-note"><a href="/auth/login">Войдите</a>, чтобы писать в чат</div>
        <% } %>
      </div>

    </div>

    <div class="sidebar">
      <div class="sidebar-block">
        <div class="sb-title"><i class="fa-solid fa-chart-bar"></i> Статистика</div>
        <div class="sb-stat"><span>Пользователей:</span><b><%= stats.users %></b></div>
        <div class="sb-stat"><span>Тем:</span><b><%= stats.threads %></b></div>
        <div class="sb-stat"><span>Постов:</span><b><%= stats.posts %></b></div>
      </div>
      <div class="sidebar-block">
        <div class="sb-title"><i class="fa-solid fa-circle" style="color:#4caf50;font-size:.6rem;vertical-align:middle"></i> В сети (<%= onlineUsers.length %>)</div>
        <% if (onlineUsers.length === 0) { %>
        <div style="font-size:.8rem;color:#888;padding:4px 0">Никого нет онлайн</div>
        <% } else { %>
        <div style="display:flex;flex-wrap:wrap;gap:6px;padding:4px 0">
          <% for (const u of onlineUsers) { %>
          <a href="/user/<%= u.username %>" title="<%= u.username %>" style="display:inline-block">
            <img src="<%= u.avatar %>" onerror="this.src='/img/default_avatar.png'" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid #4caf50">
          </a>
          <% } %>
        </div>
        <% } %>
      </div>
      <div class="sidebar-block">
        <div class="sb-title"><i class="fa-solid fa-clock"></i> Последние темы</div>
        <% for (const t of latest_threads) { %>
        <div class="sb-thread">
          <img src="<%= t.avatar %>" class="sb-avatar" onerror="this.src='/img/default_avatar.png'">
          <div class="sb-thread-info">
            <a href="/forum/thread/<%= t._id %>"><%= t.title.substring(0,32) %></a>
            <div class="sb-thread-meta"><%= t.username %> · <%= t.sectionName %></div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

</div>
<%- include('partials/footer') %>

<script>
let lastId = 0;

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

async function loadMessages() {
  const res = await fetch('/chat/messages?since=' + lastId);
  const msgs = await res.json();
  if (!msgs.length) return;
  const box = document.getElementById('chatMessages');
  const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
  msgs.forEach(m => {
    lastId = m.id;
    const d = document.createElement('div');
    d.className = 'chat-msg';
    d.innerHTML = `<img src="${escHtml(m.avatar)}" onerror="this.src='/img/default_avatar.png'"><span class="chat-user">${escHtml(m.username)}</span><span class="chat-text">${escHtml(m.message)}</span>`;
    box.appendChild(d);
  });
  if (atBottom) box.scrollTop = box.scrollHeight;
}

loadMessages();
setInterval(loadMessages, 3000);

const form = document.getElementById('chatForm');
if (form) {
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const input = document.getElementById('chatInput');
    const msg = input.value.trim();
    if (!msg) return;
    input.value = '';
    await fetch('/chat/send', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ message: msg }) });
    loadMessages();
  });
}
</script>
</body>
</html>
