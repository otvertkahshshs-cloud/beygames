<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>LOADER — DealerHook</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
.loader-page{max-width:700px;margin:40px auto;padding:0 16px}
.loader-card{background:var(--bg2);border:1px solid var(--border);border-radius:4px;padding:30px;text-align:center}
.loader-card h2{color:var(--accent);font-size:1.6rem;letter-spacing:.1em;margin-bottom:8px}
.loader-card p{color:var(--text-muted,#888);font-size:.9rem;margin-bottom:24px}
.loader-info{display:flex;justify-content:center;gap:24px;margin-bottom:28px;flex-wrap:wrap}
.loader-info-item{background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:10px 20px;font-size:.82rem}
.loader-info-item span{display:block;color:var(--accent);font-weight:700;font-size:1rem}
.btn-download{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#111;font-weight:700;font-size:.95rem;padding:12px 28px;border-radius:4px;text-decoration:none;letter-spacing:.05em;transition:.15s}
.btn-download:hover{background:#aad008}
<% if (typeof adminMode !== 'undefined' && adminMode) { %>
.upload-section{margin-top:28px;border-top:1px solid var(--border);padding-top:24px}
.upload-section label{display:block;color:#888;font-size:.82rem;margin-bottom:8px}
.upload-section input[type=file]{color:var(--text,#ccc);font-size:.85rem}
.upload-section button{margin-top:10px}
<% } %>
</style>
</head>
<body>
<%- include('partials/header') %>
<div class="container main-wrap">
<div class="loader-page">
  <div class="loader-card">
    <h2><i class="fa-solid fa-download"></i> LOADER</h2>
    <p>Официальный загрузчик DealerHook</p>

    <div class="loader-info">
      <div class="loader-info-item">Версия<span><%= loaderVersion %></span></div>
      <div class="loader-info-item">Обновлён<span><%= loaderDate %></span></div>
      <div class="loader-info-item">Статус<span style="color:#7eca2a">ONLINE</span></div>
    </div>

    <% if (loaderFile) { %>
      <a href="/loader/download" class="btn-download">
        <i class="fa-solid fa-file-arrow-down"></i> Скачать Loader
      </a>
    <% } else { %>
      <p style="color:#888">Файл пока не загружен.</p>
    <% } %>

    <% if (user && user.username === 'admin') { %>
    <div class="upload-section">
      <p style="color:#666;font-size:.8rem;margin-bottom:12px">— Панель администратора —</p>
      <form action="/loader/upload" method="POST" enctype="multipart/form-data">
        <label>Загрузить новый файл лоадера:</label>
        <input type="file" name="loader" required>
        <br>
        <label style="margin-top:10px">Версия:</label>
        <input type="text" name="version" value="<%= loaderVersion %>" style="background:var(--bg3);border:1px solid var(--border);color:var(--text,#ccc);padding:5px 8px;border-radius:3px;font-size:.85rem">
        <br>
        <button type="submit" class="btn-primary" style="margin-top:10px">Загрузить</button>
      </form>
    </div>
    <% } %>
  </div>
</div>
</div>
<%- include('partials/footer') %>
</body>
</html>
