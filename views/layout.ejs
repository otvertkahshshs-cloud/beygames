<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' — Dealerhook.cc' : 'Dealerhook.cc' %></title>
<link rel="stylesheet" href="/css/style.css">
<style>body{display:flex;flex-direction:column;min-height:100vh}.main-wrap{flex:1}</style>
</head>
<body>

<header class="header">
  <div class="container">
    <a href="/" class="logo">🎮 <span>Dealerhook.cc</span></a>
    <nav class="nav">
      <a href="/">Главная</a>
      <% if (user) { %>
        <a href="/user/<%= user.username %>">Профиль</a>
        <% if (user.role === 'admin') { %><a href="/admin">Админ</a><% } %>
        <a href="/auth/logout" class="btn-logout">Выйти</a>
      <% } else { %>
        <a href="/auth/login" class="btn-login">Войти</a>
        <a href="/auth/register" class="btn-register">Регистрация</a>
      <% } %>
    </nav>
  </div>
</header>

<div class="container main-wrap">
  <%- body %>
</div>

<footer class="footer">
  <div class="container">
    <span>© 2024 Dealerhook.cc — Игровое сообщество</span>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
