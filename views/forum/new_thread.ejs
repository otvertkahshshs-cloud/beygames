<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Новая тема — GameForum</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/header') %>
<div class="container main-wrap">
  <div class="breadcrumb"><a href="/">Главная</a> › <a href="/forum/section/<%= section._id %>"><%= section.name %></a> › <span>Новая тема</span></div>
  <div class="form-box">
    <h2>Создать тему в «<%= section.name %>»</h2>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <form method="POST" action="/forum/section/<%= section._id %>/new" enctype="multipart/form-data">
      <div class="form-group"><label>Заголовок</label><input type="text" name="title" class="form-input" required maxlength="150"></div>
      <div class="form-group"><label>Текст</label><textarea name="content" class="form-textarea" rows="10" required></textarea></div>
      <div class="form-group">
        <label>Прикрепить файл или фото (необязательно)</label>
        <label class="attach-label">
          📎 Выбрать файл
          <input type="file" name="file" class="attach-input">
        </label>
        <span class="attach-hint" style="font-size:11px;color:var(--text-muted)">Макс. 10MB · любой формат</span>
      </div>
      <button type="submit" class="btn-primary">Создать тему</button>
      <a href="/forum/section/<%= section._id %>" class="btn-cancel">Отмена</a>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
</body></html>
