<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<nav class="gs-navbar">
  <div class="gs-nav-container">
    <ul class="gs-nav-left">
      <li class="active"><a href="/"><img src="/img/logo.svg" style="width:28px;height:28px;filter:brightness(0) invert(1);vertical-align:middle"></a></li>
      <li><a href="/">FORUM</a></li>
      <li><a href="/loader">LOADER</a></li>
      <% if (user) { %><li><a href="/tickets">TICKET</a></li><% } %>
      <% if (user && user.role === 'admin') { %><li><a href="/admin">ADMIN PANEL</a></li><% } %>
    </ul>
    <div class="gs-nav-right">
      <% if (user) { %>
        <div style="position:relative;display:inline-block">
          <a href="/notifications" class="notif-bell">
            <i class="fa-solid fa-bell"></i>
            <% if (notifCount > 0) { %><span class="notif-count"><%= notifCount %></span><% } %>
          </a>
        </div>
        <a href="/user/<%= user.username %>"><%= user.username %></a>
        <a href="/auth/logout" class="btn-out">ВЫЙТИ</a>
      <% } else { %>
        <a href="/auth/login">ВОЙТИ</a>
        <a href="/auth/register" class="btn-reg">РЕГИСТРАЦИЯ</a>
      <% } %>
    </div>
  </div>
</nav>
<div class="rainbow-bar"></div>
